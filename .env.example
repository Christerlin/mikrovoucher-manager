# ---- Obligatoire -------------------------------------------------------
# PostgreSQL. Neon (neon.tech) convient bien : offre gratuite qui n'expire
# pas. Copiez la chaîne "direct" (sans -pooler) et gardez ?sslmode=require.
# Ex : postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:pass@host:5432/dbname
ADMIN_PASSWORD=choisissez-un-mot-de-passe-fort

# ---- Recommandé --------------------------------------------------------
# URL publique de cette application (scripts routeur + Return URL Pay'm).
PUBLIC_URL=https://votre-manager.onrender.com
# Origines des portails captifs (CORS). Sans cette variable : tout autorisé.
CORS_ORIGINS=http://lambda.connect,http://172.17.10.1

# ---- Paiement en ligne (optionnel : sans client_id, vouchers en lot
#      et dashboard fonctionnent, seul le paiement en ligne est désactivé)
PAYM_BASE_URL=https://plopplop.solutionip.app
PAYM_CLIENT_ID=

# ---- Base de données : TLS ---------------------------------------------
# Recommandé en production : PEM du CA de l'hébergeur (contenu ou chemin).
# DATABASE_CA_CERT=
# Dernier recours, si l'hébergeur utilise un certificat interne
# (Neon et Supabase ont des certificats publics : laissez ceci désactivé).
# DATABASE_SSL_INSECURE=false
# Taille du pool (offres gratuites : peu de connexions disponibles).
# DB_POOL_MAX=5

# ---- Avancé ------------------------------------------------------------
# TRUST_PROXY=1
# ORDER_EXPIRY_MINUTES=15
# RECONCILE_INTERVAL_MS=120000
# VERIFY_THROTTLE_MS=4000
# HANDOFF_TTL_MS=900000
# RETURN_DB_TIMEOUT_MS=2500
